APP_LOCALES="en, bg, ru, fa, de, es, fr, it, pt"
CHANNEL_TOKEN="your-channel-token"
GQL_HOST="http://localhost:3001/shop-api"
I18N_BASE_URL="https://nuxtless.unstack.dev"
NUXT_IMAGE_PROVIDER="ipx"
OG_IMAGE_SECRET="nuxt-og-image generate-secret"
PORT=8080
STRIPE_PUBLIC_KEY="pk_prod_super-long-key"
UNSPLASH_API_KEY="your-unsplash-api-key"

# 部署脚本 scripts/deploy.mjs（本地构建 + scp 上传 + pm2 restart）
SERVER_HOST=""              # 服务器主机或 IP（必填）
SERVER_USER="root"          # SSH 用户名
SERVER_PORT="22"            # SSH/SCP 端口
REMOTE_DIR=""               # 服务器上 .output/ 目标目录（必填），例如 /opt/www/nshop
APP_NAME="nshop"            # pm2 进程名
